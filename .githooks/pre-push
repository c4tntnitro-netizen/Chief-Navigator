#!/bin/sh
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
if command -v python >/dev/null 2>&1; then
    exec python "$hook_dir/check_identity.py" pre-push "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$hook_dir/check_identity.py" pre-push "$@"
fi
printf '%s\n' 'Chief Navigator identity guard requires Python 3; push blocked.' >&2
exit 1
